# Dependency folders (ตัวหนักที่สุด ไม่เอาขึ้น)
node_modules/

# Local env files (ไฟล์เก็บรหัสผ่านหรือความลับ)
.env
.env.local

# Editor folders (ไฟล์ตั้งค่าของโปรแกรมเขียนโค้ด)
.vscode/
.idea/

# OS metadata (ไฟล์ขยะของระบบปฏิบัติการ)
.DS_Store
Thumbs.db

# Build output (ไฟล์ที่ได้จากการ build ไม่ต้องเอาขึ้น)
dist/
build/

# ข้อมูลพนักงาน (ถ้าไม่อยากให้ข้อมูลจริงหลุดไปบน GitHub)
# employees.xlsx